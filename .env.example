# --- Database (local Postgres or Supabase) ---
# Supabase: Project Settings > Database > Connection string.
# DATABASE_URL = pooled connection (port 6543, add ?pgbouncer=true), DIRECT_URL = direct (port 5432)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/projecttrack"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/projecttrack"

# Long random string used to sign login sessions:  openssl rand -hex 32
AUTH_SECRET=""
APP_URL="http://localhost:3000"

# --- File storage ---
# "local" stores files on disk in UPLOAD_DIR (fine for one server / development).
# "supabase" stores files in a private Supabase Storage bucket (use this on Vercel).
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="projecttrack"
MAX_UPLOAD_MB="25"

# --- Email (optional). Without SMTP settings, notifications are in-app only. ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ProjectTrack <no-reply@example.edu>"

# Show the demo-account buttons on the login page. Set "false" in production.
DEMO_MODE="true"

# Protects /api/cron/reminders (deadline reminder job)
CRON_SECRET=""
